# Kopieren nach .env und anpassen:  cp .env.example .env

# Docker-Image (Standard: fertiges Image von GitHub). Für eine andere Version z. B. …:33 oder …:latest
CDB_IMAGE=ghcr.io/normanweis/manaschmiede:51

# Variante: https (eigene Domain + Caddy) oder tunnel (Cloudflare-Tunnel, keine offenen Ports)
COMPOSE_PROFILES=https

# Deine (Sub-)Domain, deren DNS-Eintrag (A/AAAA) auf den Server zeigt – für HTTPS über Caddy
CDB_DOMAIN=commander.example.de
# E-Mail für Let's Encrypt (Hinweise zu Zertifikaten)
ACME_EMAIL=du@example.de

# Erster Administrator (Passwort mind. 8 Zeichen; bei jedem Start gesetzt – nach dem Einrichten gern wieder entfernen)
CDB_ADMIN_USER=admin
CDB_ADMIN_PASSWORD=bitte-ein-langes-eigenes-passwort

# Forge-Duelle: gleichzeitig laufende Duelle, Partien je Duell, Java-Speicher je Duell
CDB_MAX_DUELS=1
CDB_MAX_GAMES=20
CDB_FORGE_XMX=2048m
# Speichergrenze für den App-Container
CDB_MEM_LIMIT=4g

# Anmeldung bleibt so viele Tage gültig
CDB_SESSION_DAYS=30

# Tägliche Aktualisierung (Regeln, Precons, Kartendaten mit Preisen): Stunde der Prüfung (0–23, "off" = aus)
CDB_UPDATE_HOUR=4
# Kartendaten neu laden, sobald sie so viele Tage alt sind und Scryfall neuere hat (1 = täglich frische Preise)
CDB_CARDS_MAX_AGE_DAYS=1
# Cardmarket-Preisliste (öffentliche Dateien, täglich); nur ändern, wenn Cardmarket die Adressen ändert
#CDB_CM_PRICE_URL=https://downloads.s3.cardmarket.com/productCatalog/priceGuide/price_guide_1.json
#CDB_CM_PRODUCTS_URL=https://downloads.s3.cardmarket.com/productCatalog/productList/products_singles_1.json
# Zeitzone für Uhrzeit der Prüfung und Zeitstempel
TZ=Europe/Berlin

# Nur für den Betrieb über einen Cloudflare-Tunnel (Profil "tunnel"):
# TUNNEL_TOKEN=
